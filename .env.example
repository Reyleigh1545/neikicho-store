# Copy to .env for local runs. On Vercel, add the same keys under Settings → Environment Variables.
# Neon: Dashboard → your project → Connect → copy the connection string (the one WITHOUT "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Password for admin@nekicho.com (team-only /admin page)
ADMIN_PASSWORD="change-me"
